# 构建上下文排除项（避免把大文件/产物拷入镜像构建上下文）
.git
.gitignore
.idea
_bin
_lib
build
build-*
cmake-build-*
logs
generated_configs
weights
# 3rd_party 整体排除：镜像内由 install_deps.sh 全自动生成，
# 避免继承宿主机 vendored 头/库导致版本不可复现
3rd_party
.deps-build
__pycache__
*.pyc
# Golden baselines are ~500MB of JSON/PNG for label heavy-golden only.
# The image `check` target excludes that label, the runtime install does
# not ship test/, and CodeQL traces `cmake --build` (not those tests).
# Baking them into the loaded image exhausted the GitHub runner while
# buildx exported it (write test/golden/ppmatting_matting.json: no space
# left on device).
test/golden
