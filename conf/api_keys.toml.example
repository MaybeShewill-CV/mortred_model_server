# The gateway listens only when MORTRED_GATEWAY_AUTH_TOKEN, MORTRED_API_TOKEN,
# and MORTRED_METRICS_TOKEN are all set and pairwise different. This key file
# cannot stand in for a missing inference token or management token.
#
# Example only. Copy to conf/api_keys.toml on the machine (mode 600) after
# replacing every hash with at least one real [keys.*] entry. A comment-only
# copy is not authentication. The runtime file is gitignored; this example is
# not loaded by the gateway.
#
# echo -n "your-secret-key" | sha256sum

# [keys.client-a]
# hash = "<sha256 hex of the Bearer secret>"
# scope = "inference"
# rate_limit_qps = 100   # GCRA QPS at gateway (tenant quota)
# max_inflight = 8       # per-tenant in-flight (0 = unlimited)
# max_queue = 32         # residency until upstream callback (0 = unlimited); parsed by ApiKeyManager::load
# worker_budget = 4      # hard concurrent worker budget (0 = unlimited); 429 when exceeded
# enabled = true
