# The gateway listens only when MORTRED_GATEWAY_AUTH_TOKEN, MORTRED_API_TOKEN,
# and MORTRED_METRICS_TOKEN are all set and pairwise different. This key file
# cannot stand in for a missing inference token or management token.
#
# Example only. Copy to conf/api_keys.toml on the machine (mode 600) after
# replacing every hash with at least one real [keys.*] entry. A comment-only
# copy is not authentication. The runtime file is gitignored; this example is
# not loaded by the gateway.
#
# Mint a key with the helper (32 random bytes; the plaintext is printed once and
# only its hash is written here):
#   ./scripts/mint_api_key.sh --name client-a --scope inference
#   ./scripts/mint_api_key.sh --name client-a --scope inference --append conf/api_keys.toml
#
# Do NOT hash a memorable phrase. The gateway verifies the bearer secret with an
# unsalted SHA-256 (fast by design: a bearer token, not a password), so key
# entropy IS the security and a leaked config makes a weak key reversible.
# scripts/check_api_keys_hashing.sh rejects a config that still carries the hash
# of the documented example secret, and `mortredctl doctor` runs that check.

# Optional per-file KDF salt: when the [kdf] section is present, every hash in
# this file is sha256(salt + key) instead of the bare sha256(key). A stolen
# config then resists offline brute force per deployment (the attacker cannot
# precompute against other deployments). Legacy unsalted entries keep working:
# the gateway tries the salted hash first, the bare hash second. Minted keys
# pick the salt up automatically from the --append target.
#
# [kdf]
# salt = "any non-secret per-deployment string"
#
# [keys.client-a]
# hash = "<sha256 hex of the Bearer secret>"
# scope = "inference"
# rate_limit_qps = 100   # GCRA QPS at gateway (tenant quota)
# max_inflight = 8       # per-tenant in-flight (0 = unlimited)
# max_queue = 32         # residency until upstream callback (0 = unlimited); parsed by ApiKeyManager::load
# worker_budget = 4      # hard concurrent worker budget (0 = unlimited); 429 when exceeded
# enabled = true
