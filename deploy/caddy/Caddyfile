# TLS reverse proxy in front of Mortred.
#
# Mortred itself is plain HTTP. Keep gateway/supervisor on 127.0.0.1
# (compose / docker-run default) and let Caddy terminate TLS.
#
# 1. Point DNS for the site names at this machine (ports 80 and 443 open).
# 2. Replace infer.example.com / admin.example.com below.
# 3. Run:
#      caddy run --config deploy/caddy/Caddyfile
#
# Leave the admin site commented out unless the console must be on the
# internet. Do not docker-publish model ports.

infer.example.com {
	reverse_proxy 127.0.0.1:8080
}

# admin.example.com {
# 	reverse_proxy 127.0.0.1:8787
# }

# Local smoke without public DNS (Caddy internal CA, https://localhost:8443):
# :8443 {
# 	tls internal
# 	reverse_proxy 127.0.0.1:8080
# }
