  "cards": [
    {
      "dot": "cyan",
      "title": "分层与解耦",
      "items": [
        "控制面(supervisor/gateway) 与数据面(模型服务) 分离，模型服务只绑 loopback",
        "HTTP 层完全不知道后端类型：CvServerSpec 只提供 worker 工厂 + 响应填充器",
        "推理引擎被 InferenceSession 抹平，新增后端不动任何模型代码"
      ]
    },
    {
      "dot": "emerald",
      "title": "一条同步请求的生命周期",
      "items": [
        "限流 → Bearer 鉴权 → Content-Type/413 → JSON 解析 → 队列深度 429 背压",
        "WFGoTask 携带全部逐请求状态，从 BlockingQueue 领一个 worker",
        "worker.run(base64) → 解码/预处理 → 引擎推理 → 后处理映射回原图坐标",
        "run_time EWMA 驱动 Retry-After，模型卡死可交给 supervisor 重启"
      ]
    },
    {
      "dot": "amber",
      "title": "吞吐与长任务",
      "items": [
        "max_batch_size>1 时收集并发请求打包成 [N,…] 单次引擎调用，失败项彼此隔离",
        "引擎拒绝批形状时透明回退逐条执行，静态 batch-1 引擎同样可用",
        "扩散/SAM AMG 走 /jobs：202+Location → status/wait → result(409/结果)"
      ]
    },
    {
      "dot": "rose",
      "title": "配置与工程化",
      "items": [
        "conf/server 与 conf/model 双层 TOML 是唯一行为来源：[SERVER] + [MODEL.backend]/[MODEL.params]",
        "weights_manifest 清单驱动权重拉取与 sha256 校验，TRT engine 离线构建",
        "gpu/cpu 双构建 profile，cpu 完全编译掉 TensorRT；27 服务 + 34 基准可执行文件同源生成"
      ]
    }
  ]
}
