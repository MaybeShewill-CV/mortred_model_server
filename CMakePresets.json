{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 18,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "tests-only",
      "displayName": "Tests Only (CI / quick verification)",
      "description": "Build common library and unit tests only. No CUDA/MNN/TRT required.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/tests-only",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "OFF",
        "MORTRED_ENABLE_WERROR": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tests-only-werror",
      "displayName": "Tests Only with Werror",
      "description": "CI quality gate: build common library and tests with warnings as errors.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/werror",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "OFF",
        "MORTRED_ENABLE_WERROR": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tests-only-tsan",
      "displayName": "Tests Only with ThreadSanitizer",
      "description": "Concurrency gate: build the sanitizer-labeled async tests with -fsanitize=thread. Run with: ctest --preset tests-only-tsan -L sanitizer",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/tests-only-tsan",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "OFF",
        "MORTRED_ENABLE_WERROR": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      }
    },
    {
      "name": "tests-only-asan",
      "displayName": "Tests Only with AddressSanitizer + UBSan",
      "description": "Memory gate: build the tests-only suite with -fsanitize=address,undefined. Run with: ctest --preset tests-only-asan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/tests-only-asan",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "OFF",
        "MORTRED_ENABLE_WERROR": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "full-cpu",
      "displayName": "Full Build (cpu profile)",
      "description": "Full model/server/apps build with MNN-CPU + ORT-CPU backends; TensorRT compiled out. No CUDA required.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/full-cpu",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "ON",
        "MORTRED_BUILD_PROFILE": "cpu",
        "MORTRED_ENABLE_WERROR": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "full",
      "displayName": "Full Build",
      "description": "Build all models, servers, tools and web console. Requires CUDA + vendored engines.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/full",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "ON",
        "MORTRED_ENABLE_WERROR": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "full-werror",
      "displayName": "Full Build with Werror",
      "description": "Quality gate: full build (models/server/apps) with warnings as errors. Requires CUDA + vendored engines.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/full-werror",
      "cacheVariables": {
        "MORTRED_BUILD_FULL": "ON",
        "MORTRED_ENABLE_WERROR": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tests-only",
      "configurePreset": "tests-only",
      "jobs": 8
    },
    {
      "name": "tests-only-werror",
      "configurePreset": "tests-only-werror",
      "jobs": 8
    },
    {
      "name": "tests-only-tsan",
      "configurePreset": "tests-only-tsan",
      "jobs": 8
    },
    {
      "name": "tests-only-asan",
      "configurePreset": "tests-only-asan",
      "jobs": 8
    },
    {
      "name": "full",
      "configurePreset": "full",
      "jobs": 8
    },
    {
      "name": "full-cpu",
      "configurePreset": "full-cpu",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "tests-only",
      "configurePreset": "tests-only",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-only-werror",
      "configurePreset": "tests-only-werror",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-only-tsan",
      "configurePreset": "tests-only-tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "labels": ["sanitizer"]
      }
    },
    {
      "name": "tests-only-asan",
      "configurePreset": "tests-only-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
